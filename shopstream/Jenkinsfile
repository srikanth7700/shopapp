// Jenkins declarative pipeline: the same stages as the GitHub Actions workflow.
// Use it with a Multibranch Pipeline job. The agent needs JDK 25, Node 22,
// Docker, kubectl, kustomize and Chrome (for the Angular tests).
//
// Credentials to create in Jenkins:
//   registry-credentials   username/password for the container registry
//   kubeconfig-shopstream  "secret file" with a kubeconfig for the target cluster

def SERVICES = [
    'api-gateway', 'user-service', 'product-service', 'inventory-service',
    'order-service', 'payment-service', 'notification-service'
]

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY = 'ghcr.io/your-github-user'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Build and test') {
            parallel {
                stage('Backend') {
                    steps {
                        sh './mvnw -B verify'
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        dir('frontend') {
                            sh 'npm ci'
                            sh 'npm run test:ci'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Docker images') {
            when { branch 'main' }
            steps {
                script {
                    SERVICES.each { service ->
                        sh "docker build -f backend.Dockerfile --build-arg SERVICE=${service} -t ${REGISTRY}/shopstream-${service}:${IMAGE_TAG} ."
                    }
                    sh "docker build -t ${REGISTRY}/shopstream-frontend:${IMAGE_TAG} frontend"
                }
            }
        }

        stage('Push images') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'registry-credentials',
                                                  usernameVariable: 'REGISTRY_USER',
                                                  passwordVariable: 'REGISTRY_PASSWORD')]) {
                    sh 'echo "$REGISTRY_PASSWORD" | docker login ghcr.io -u "$REGISTRY_USER" --password-stdin'
                    script {
                        (SERVICES + ['frontend']).each { service ->
                            sh "docker push ${REGISTRY}/shopstream-${service}:${IMAGE_TAG}"
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when { branch 'main' }
            steps {
                // Manual approval gate before production.
                input message: "Deploy ${env.IMAGE_TAG} to Kubernetes?", ok: 'Deploy'
                withCredentials([file(credentialsId: 'kubeconfig-shopstream', variable: 'KUBECONFIG')]) {
                    dir('infra/k8s/overlays/aws') {
                        script {
                            (SERVICES + ['frontend']).each { service ->
                                sh "kustomize edit set image shopstream/${service}=${REGISTRY}/shopstream-${service}:${IMAGE_TAG}"
                            }
                        }
                    }
                    sh 'kubectl apply -k infra/k8s/overlays/aws'
                    sh 'kubectl -n shopstream rollout status deployment/order-service --timeout=300s'
                }
            }
        }
    }

    post {
        always {
            deleteDir()
        }
        failure {
            echo 'Build failed. Check the stage logs above.'
        }
    }
}
