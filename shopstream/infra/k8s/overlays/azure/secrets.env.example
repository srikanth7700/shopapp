# Copy to secrets.env (which git ignores) and fill in real values.
DB_USERNAME=shopstream
DB_PASSWORD=the-password-you-used-in-provision.sh
JWT_SECRET=use-a-long-random-string-of-at-least-32-characters
ADMIN_EMAIL=admin@shopstream.dev
ADMIN_PASSWORD=choose-a-strong-admin-password
# Event Hubs connection string goes inside the JAAS config (keep the quotes):
SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="$ConnectionString" password="Endpoint=sb://REPLACE.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=REPLACE";
